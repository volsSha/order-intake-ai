# Copy to .env and fill in. Never commit .env.
# Provider: OpenRouter if its key is set, otherwise OpenAI directly (LLM_PROVIDER=auto).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional overrides (defaults shown)
LLM_PROVIDER=auto
MODEL_ID=openai/gpt-6-luna
# OpenAI model name used with the OpenAI fallback; default strips "openai/" from MODEL_ID
OPENAI_MODEL_ID=
MODEL_REASONING_EFFORT=low
LLM_MODE=replay
DB_PATH=var/intake.db
